<%- include('partials/header') %>

<h1>Comunidad Educativa</h1>

<% if (comunidad.length === 0) { %>
    <p>Aún no hay personas registradas.</p>
<% } else { %>
    <div class="card-grid">
        <% comunidad.forEach(function(persona, i) { %>
            <article class="card aparece" style="transition-delay: <%= Math.min(i, 5) * 70 %>ms">
                <% if (persona.foto_url) { %>
                    <img src="<%= persona.foto_url %>" alt="<%= persona.nombre %>" class="card-img">
                <% } %>
                <h3><%= persona.nombre %></h3>
                <% if (persona.cargo) { %><p class="fecha"><%= persona.cargo %></p><% } %>
            </article>
        <% }) %>
    </div>
<% } %>

<%- include('partials/footer') %>

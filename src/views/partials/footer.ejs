    </main>
    <footer class="site-footer">
        <div class="container">
            <% if (contacto && (contacto.telefono || contacto.correo)) { %>
                <p class="footer-contacto">
                    <% if (contacto.telefono) { %>Tel: <%= contacto.telefono %><% } %>
                    <% if (contacto.telefono && contacto.correo) { %> · <% } %>
                    <% if (contacto.correo) { %><%= contacto.correo %><% } %>
                </p>
            <% } %>
            <p>&copy; <%= new Date().getFullYear() %> Institución Educativa Distrital Técnica para el Desarrollo del Talento Humano. Proyecto SENA.</p>
        </div>
    </footer>
    <script src="/js/evitar-doble-envio.js"></script>
    <script src="/js/lightbox.js"></script>
    <script src="/js/aparecer-al-scroll.js"></script>
</body>
</html>

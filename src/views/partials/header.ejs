<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %> · IED Talento Humano</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="topbar">
        <div class="container topbar-inner">
            <div class="topbar-links">
                <a href="/alianzas" class="topbar-link">🤝 Alianzas</a>
            </div>
            <% if (sitio && (sitio.instagram_url || sitio.facebook_url)) { %>
                <div class="topbar-social">
                    <% if (sitio.instagram_url) { %>
                        <a href="<%= sitio.instagram_url %>" target="_blank" rel="noopener" aria-label="Instagram">
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                        </a>
                    <% } %>
                    <% if (sitio.facebook_url) { %>
                        <a href="<%= sitio.facebook_url %>" target="_blank" rel="noopener" aria-label="Facebook">
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                        </a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/">
                <% if (sitio && sitio.logo_url) { %>
                    <img src="<%= sitio.logo_url %>" alt="IED Técnica para el Desarrollo del Talento Humano" class="brand-logo">
                <% } else { %>
                    <span class="brand-texto">IED Técnica para el Desarrollo del Talento Humano</span>
                <% } %>
            </a>

            <button type="button" class="hamburger-btn" id="btn-hamburguesa" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-principal">
                <span></span><span></span><span></span>
            </button>

            <nav class="nav" id="nav-principal">
                <a href="/">Inicio</a>

                <div class="nav-dropdown">
                    <button type="button" class="nav-dropdown-btn">Quiénes somos<span class="nav-caret">▾</span></button>
                    <div class="nav-dropdown-menu">
                        <a href="/institucion">Institución</a>
                        <a href="/comunidad-educativa">Comunidad Educativa</a>
                        <a href="/himno">Himno Escolar</a>
                    </div>
                </div>

                <div class="nav-dropdown">
                    <button type="button" class="nav-dropdown-btn">Conócenos<span class="nav-caret">▾</span></button>
                    <div class="nav-dropdown-menu">
                        <a href="/noticias">Noticias</a>
                        <a href="/eventos">Eventos</a>
                        <a href="/deportes">Deportes</a>
                        <a href="/campeonatos">Intercursos</a>
                        <a href="/mejores-puestos">Puestos de honor</a>
                        <a href="/icfes">Mejores ICFES</a>
                    </div>
                </div>

                <a href="/galeria">Galería</a>

                <a href="/contacto" class="nav-contacto-btn">Contáctanos</a>

                <% if (usuario && usuario.rol === 'admin') { %>
                    <a href="/admin">Panel admin</a>
                    <form method="POST" action="/logout" class="nav-form"><button type="submit" class="link-btn">Salir</button></form>
                <% } else if (usuario) { %>
                    <span>Hola, <%= usuario.nombre %></span>
                    <form method="POST" action="/logout" class="nav-form"><button type="submit" class="link-btn">Salir</button></form>
                <% } else { %>
                    <a href="/login">Mi cuenta</a>
                <% } %>
            </nav>
        </div>
    </header>
    <main class="container main-content">

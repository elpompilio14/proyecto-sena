<%- include('partials/header') %>

<div class="auth-wrapper">
    <div class="auth-card-simple aparece">
        <h1>¿Se te olvidó tu contraseña?</h1>
        <p>Escribe el correo con el que te registraste y te enviaremos un código para crear una contraseña nueva.</p>

        <% if (error) { %>
            <p class="error"><%= error %></p>
        <% } %>

        <form method="POST" action="/recuperar-contrasena" class="form">
            <label>
                Correo electrónico
                <input type="email" name="email" required autofocus>
            </label>
            <button type="submit">Enviar código</button>
        </form>

        <p class="auth-mobile-switch"><a href="/login">&larr; Volver a iniciar sesión</a></p>
    </div>
</div>

<%- include('partials/footer') %>

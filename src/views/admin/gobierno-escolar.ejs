<%- include('../partials/header') %>

<p><a href="/admin">&larr; Panel admin</a></p>
<h1>Gobierno Escolar</h1>

<form method="POST" action="/admin/gobierno-escolar" class="form" enctype="multipart/form-data">
    <label>Nombre<input type="text" name="nombre" required></label>
    <label>Rol (ej: Personero, Contralor, Representante de curso)<input type="text" name="rol"></label>
    <label>Foto (opcional, se ve mejor si es cuadrada)<input type="file" name="imagen" accept="image/*"></label>
    <button type="submit">Agregar miembro</button>
</form>

<% if (miembros.length === 0) { %>
    <p>Aún no hay miembros registrados.</p>
<% } else { %>
    <table class="tabla">
        <thead><tr><th>Nombre</th><th>Rol</th><th></th></tr></thead>
        <tbody>
            <% miembros.forEach(function(m) { %>
                <tr>
                    <td><%= m.nombre %></td>
                    <td><%= m.rol || '-' %></td>
                    <td class="acciones">
                        <a href="/admin/gobierno-escolar/<%= m.id %>/editar" class="btn-editar">Editar</a>
                        <form method="POST" action="/admin/gobierno-escolar/<%= m.id %>/eliminar">
                            <button type="submit" class="btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>

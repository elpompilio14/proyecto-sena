<%- include('../partials/header') %>

<p><a href="/admin/grupos-estudiantiles">&larr; Grupos Estudiantiles</a></p>
<h1>Editar grupo</h1>

<form method="POST" action="/admin/grupos-estudiantiles/<%= grupo.id %>/editar" class="form" enctype="multipart/form-data">
    <label>Nombre<input type="text" name="nombre" value="<%= grupo.nombre %>" required></label>
    <label>Encargado (docente o estudiante líder)<input type="text" name="encargado" value="<%= grupo.encargado || '' %>"></label>
    <label>Descripción<textarea name="descripcion" rows="3"><%= grupo.descripcion || '' %></textarea></label>
    <% if (grupo.foto_url) { %>
        <img src="<%= grupo.foto_url %>" alt="Foto actual" class="card-img">
    <% } %>
    <label>Cambiar foto (opcional)<input type="file" name="imagen" accept="image/*" data-recorte="rectangulo" data-recorte-aspecto="1.3333"></label>
    <input type="hidden" name="foto_actual" value="<%= grupo.foto_url || '' %>">
    <label>Enlace a su página completa (opcional, ej: /comite-ecologico). Si lo dejas vacío, la tarjeta no será clicable<input type="text" name="enlace_url" value="<%= grupo.enlace_url || '' %>" placeholder="/mi-pagina"></label>
    <button type="submit">Guardar cambios</button>
</form>

<%- include('../partials/footer') %>

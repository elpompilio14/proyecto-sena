<%- include('../partials/header') %>

<p><a href="/admin/media-tecnica">&larr; Media Técnica</a></p>
<h1>Editar categoría</h1>

<form method="POST" action="/admin/media-tecnica/<%= categoria.id %>/editar" class="form" enctype="multipart/form-data">
    <label>Nombre<input type="text" name="nombre" value="<%= categoria.nombre %>" required></label>
    <% if (categoria.imagen_url) { %>
        <img src="<%= categoria.imagen_url %>" alt="Imagen actual" class="card-img">
    <% } %>
    <label>Cambiar imagen (opcional)<input type="file" name="imagen" accept="image/*"></label>
    <input type="hidden" name="imagen_actual" value="<%= categoria.imagen_url || '' %>">
    <label>Descripción (para la página de la categoría)<textarea name="descripcion" rows="4"><%= categoria.descripcion || '' %></textarea></label>
    <label>Orden (los números más bajos salen primero)<input type="number" name="orden" value="<%= categoria.orden %>"></label>
    <button type="submit">Guardar cambios</button>
</form>

<%- include('../partials/footer') %>

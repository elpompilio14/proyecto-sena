<%- include('../partials/header') %>

<p><a href="/admin/equipo-desarrollo">&larr; Equipo de Desarrollo</a></p>
<h1>Editar miembro</h1>

<form method="POST" action="/admin/equipo-desarrollo/<%= miembro.id %>/editar" class="form" enctype="multipart/form-data">
    <label>Nombre<input type="text" name="nombre" value="<%= miembro.nombre %>" required></label>
    <label>Rol<input type="text" name="rol" value="<%= miembro.rol || '' %>"></label>
    <% if (miembro.foto_url) { %>
        <img src="<%= miembro.foto_url %>" alt="Foto actual" class="card-img">
    <% } %>
    <label>Cambiar foto (opcional)<input type="file" name="imagen" accept="image/*"></label>
    <input type="hidden" name="foto_actual" value="<%= miembro.foto_url || '' %>">
    <button type="submit">Guardar cambios</button>
</form>

<%- include('../partials/footer') %>

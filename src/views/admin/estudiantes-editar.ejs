<%- include('../partials/header') %>

<p><a href="/admin/estudiantes">&larr; Estudiantes</a></p>
<h1>Editar estudiante</h1>

<form method="POST" action="/admin/estudiantes/<%= estudiante.id %>/editar" class="form" enctype="multipart/form-data">
    <label>Nombres<input type="text" name="nombres" value="<%= estudiante.nombres %>" required></label>
    <label>Apellidos<input type="text" name="apellidos" value="<%= estudiante.apellidos %>" required></label>
    <label>
        Grado
        <select name="grado_id">
            <option value="">-- Sin grado --</option>
            <% grados.forEach(function(g) { %>
                <option value="<%= g.id %>" <%= estudiante.grado_id === g.id ? 'selected' : '' %>><%= g.nombre %></option>
            <% }) %>
        </select>
    </label>
    <% if (estudiante.foto_url) { %>
        <img src="<%= estudiante.foto_url %>" alt="Foto actual" class="card-img">
    <% } %>
    <label>Cambiar foto (opcional)<input type="file" name="imagen" accept="image/*" data-recorte="rectangulo" data-recorte-aspecto="1"></label>
    <input type="hidden" name="foto_actual" value="<%= estudiante.foto_url || '' %>">
    <button type="submit">Guardar cambios</button>
</form>

<%- include('../partials/footer') %>

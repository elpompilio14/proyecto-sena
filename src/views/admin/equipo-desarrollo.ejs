<%- include('../partials/header') %>

<p><a href="/admin">&larr; Panel admin</a></p>
<h1>Equipo de Desarrollo</h1>

<form method="POST" action="/admin/equipo-desarrollo" class="form" enctype="multipart/form-data">
    <label>Nombre<input type="text" name="nombre" required></label>
    <label>Rol (ej: Desarrollador, Diseñador, Base de datos)<input type="text" name="rol"></label>
    <label>Foto (opcional, se ve mejor si es cuadrada)<input type="file" name="imagen" accept="image/*"></label>
    <label>Orden (los números más bajos salen primero; si empatan, se ordenan por nombre)<input type="number" name="orden" value="0"></label>
    <button type="submit">Agregar miembro</button>
</form>

<% if (miembros.length === 0) { %>
    <p>Aún no hay miembros registrados.</p>
<% } else { %>
    <table class="tabla">
        <thead><tr><th class="tabla-col-foto">Foto</th><th>Nombre</th><th>Rol</th><th>Orden</th><th></th></tr></thead>
        <tbody>
            <% miembros.forEach(function(m) { %>
                <tr>
                    <td>
                        <% if (m.foto_url) { %>
                            <img src="<%= m.foto_url %>" alt="<%= m.nombre %>" class="tabla-foto-mini">
                        <% } else { %>
                            <span class="tabla-foto-vacia">—</span>
                        <% } %>
                    </td>
                    <td><%= m.nombre %></td>
                    <td><%= m.rol || '-' %></td>
                    <td><%= m.orden %></td>
                    <td class="acciones">
                        <a href="/admin/equipo-desarrollo/<%= m.id %>/editar" class="btn-editar">Editar</a>
                        <form method="POST" action="/admin/equipo-desarrollo/<%= m.id %>/eliminar">
                            <button type="submit" class="btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>

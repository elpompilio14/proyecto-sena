<%- include('../partials/header') %>

<p><a href="/admin">&larr; Panel admin</a></p>
<h1>Información institucional</h1>

<form method="POST" action="/admin/institucion" class="form" enctype="multipart/form-data">
    <% if (info && info.fondo_url) { %>
        <img src="<%= info.fondo_url %>" alt="Fondo actual" class="card-img">
    <% } %>
    <label>Foto de fondo del inicio (opcional, se ve detrás del título en la portada)<input type="file" name="fondo" accept="image/*"></label>
    <input type="hidden" name="fondo_url_actual" value="<%= info && info.fondo_url ? info.fondo_url : '' %>">

    <label>Historia<textarea name="historia" rows="4"><%= info ? info.historia : '' %></textarea></label>
    <label>Misión<textarea name="mision" rows="3"><%= info ? info.mision : '' %></textarea></label>
    <label>Visión<textarea name="vision" rows="3"><%= info ? info.vision : '' %></textarea></label>
    <label>Principios<textarea name="principios" rows="3"><%= info ? info.principios : '' %></textarea></label>
    <label>Valores<textarea name="valores" rows="3"><%= info ? info.valores : '' %></textarea></label>

    <label>Texto del Escudo<textarea name="escudo_texto" rows="4"><%= info ? info.escudo_texto : '' %></textarea></label>
    <% if (info && info.escudo_url) { %>
        <img src="<%= info.escudo_url %>" alt="Escudo actual" class="card-img">
    <% } %>
    <label>Foto del escudo (opcional)<input type="file" name="escudo" accept="image/*"></label>
    <input type="hidden" name="escudo_url_actual" value="<%= info && info.escudo_url ? info.escudo_url : '' %>">

    <label>Texto de la Bandera<textarea name="bandera_texto" rows="4"><%= info ? info.bandera_texto : '' %></textarea></label>
    <% if (info && info.bandera_url) { %>
        <img src="<%= info.bandera_url %>" alt="Bandera actual" class="card-img">
    <% } %>
    <label>Foto de la bandera (opcional)<input type="file" name="bandera" accept="image/*"></label>
    <input type="hidden" name="bandera_url_actual" value="<%= info && info.bandera_url ? info.bandera_url : '' %>">

    <label>Dirección Sede 1<textarea name="ubicacion_sede1" rows="2"><%= info ? info.ubicacion_sede1 : '' %></textarea></label>
    <label>Dirección Sede 2<textarea name="ubicacion_sede2" rows="2"><%= info ? info.ubicacion_sede2 : '' %></textarea></label>
    <label>Link de YouTube del Himno Escolar (opcional)<input type="text" name="himno_url" value="<%= info && info.himno_url ? info.himno_url : '' %>" placeholder="https://www.youtube.com/watch?v=..."></label>
    <label>Letra del Himno (pégala aquí, respeta los saltos de línea de cada estrofa)<textarea name="himno_letra" rows="10"><%= info ? info.himno_letra : '' %></textarea></label>

    <button type="submit">Guardar cambios</button>
</form>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<p><a href="/admin">&larr; Panel admin</a></p>
<h1>Grados y cursos</h1>

<form method="POST" action="/admin/grados" class="form">
    <label>Nombre del curso (ej: 6-A)<input type="text" name="nombre" required></label>
    <label>Grado (ej: 6)<input type="number" name="nivel" min="1" max="13" required></label>
    <button type="submit">Crear curso</button>
</form>

<% if (grados.length === 0) { %>
    <p>Aún no hay grados registrados.</p>
<% } else { %>
    <table class="tabla">
        <thead><tr><th>Curso</th><th>Grado</th><th></th></tr></thead>
        <tbody>
            <% grados.forEach(function(g) { %>
                <tr>
                    <td><%= g.nombre %></td>
                    <td><%= g.nivel %></td>
                    <td class="acciones">
                        <a href="/admin/grados/<%= g.id %>/editar" class="btn-editar">Editar</a>
                        <form method="POST" action="/admin/grados/<%= g.id %>/eliminar">
                            <button type="submit" class="btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>

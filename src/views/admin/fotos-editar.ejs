<%- include('../partials/header') %>

<p><a href="/admin/fotos">&larr; Galería</a></p>
<h1>Editar foto</h1>

<form method="POST" action="/admin/fotos/<%= foto.id %>/editar" class="form" enctype="multipart/form-data">
    <% const fFecha = new Date(foto.fecha); %>
    <% const fFechaIso = `${fFecha.getFullYear()}-${String(fFecha.getMonth() + 1).padStart(2, '0')}-${String(fFecha.getDate()).padStart(2, '0')}`; %>
    <label>Título (opcional)<input type="text" name="titulo" value="<%= foto.titulo || '' %>"></label>
    <label>Fecha (se usa para agrupar por mes en la galería)<input type="date" name="fecha" value="<%= fFechaIso %>"></label>
    <% if (esVideo(foto.url)) { %>
        <video src="<%= foto.url %>" controls class="card-img"></video>
    <% } else { %>
        <img src="<%= foto.url %>" alt="Foto actual" class="card-img">
    <% } %>
    <label>Cambiar archivo (opcional)<input type="file" name="imagen" accept="image/*,video/*"></label>
    <input type="hidden" name="url_actual" value="<%= foto.url %>">
    <label>
        Evento relacionado (opcional)
        <select name="evento_id">
            <option value="">-- Ninguno --</option>
            <% eventos.forEach(function(ev) { %>
                <option value="<%= ev.id %>" <%= foto.evento_id === ev.id ? 'selected' : '' %>><%= ev.titulo %></option>
            <% }) %>
        </select>
    </label>
    <label>
        Noticia relacionada (opcional)
        <select name="noticia_id">
            <option value="">-- Ninguna --</option>
            <% noticias.forEach(function(n) { %>
                <option value="<%= n.id %>" <%= foto.noticia_id === n.id ? 'selected' : '' %>><%= n.titulo %></option>
            <% }) %>
        </select>
    </label>
    <button type="submit">Guardar cambios</button>
</form>

<%- include('../partials/footer') %>

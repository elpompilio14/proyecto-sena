<%- include('../partials/header') %>

<p><a href="/admin/campeonatos">&larr; Campeonatos</a></p>
<h1>Editar campeonato</h1>

<form method="POST" action="/admin/campeonatos/<%= campeonato.id %>/editar" class="form">
    <label>Nombre<input type="text" name="nombre" value="<%= campeonato.nombre %>" required></label>
    <label>
        Deporte
        <select name="deporte_id" required>
            <% deportes.forEach(function(d) { %>
                <option value="<%= d.id %>" <%= campeonato.deporte_id === d.id ? 'selected' : '' %>><%= d.nombre %></option>
            <% }) %>
        </select>
    </label>
    <label>Fecha inicio<input type="date" name="fecha_inicio" value="<%= campeonato.fecha_inicio ? campeonato.fecha_inicio.toISOString().split('T')[0] : '' %>"></label>
    <label>Fecha fin<input type="date" name="fecha_fin" value="<%= campeonato.fecha_fin ? campeonato.fecha_fin.toISOString().split('T')[0] : '' %>"></label>
    <label>Descripción<textarea name="descripcion" rows="3"><%= campeonato.descripcion || '' %></textarea></label>
    <button type="submit">Guardar cambios</button>
</form>

<%- include('../partials/footer') %>

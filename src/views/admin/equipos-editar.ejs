<%- include('../partials/header') %>

<p><a href="/admin/equipos">&larr; Equipos</a></p>
<h1>Editar equipo</h1>

<form method="POST" action="/admin/equipos/<%= equipo.id %>/editar" class="form" enctype="multipart/form-data">
    <label>Nombre<input type="text" name="nombre" value="<%= equipo.nombre %>" required></label>
    <label>
        Deporte
        <select name="deporte_id" required>
            <% deportes.forEach(function(d) { %>
                <option value="<%= d.id %>" <%= equipo.deporte_id === d.id ? 'selected' : '' %>><%= d.nombre %></option>
            <% }) %>
        </select>
    </label>
    <label>Categoría<input type="text" name="categoria" value="<%= equipo.categoria || '' %>"></label>
    <label>Entrenador<input type="text" name="entrenador" value="<%= equipo.entrenador || '' %>"></label>
    <% if (equipo.foto_url) { %>
        <img src="<%= equipo.foto_url %>" alt="Foto actual" class="card-img">
    <% } %>
    <label>Cambiar foto (opcional)<input type="file" name="imagen" accept="image/*"></label>
    <input type="hidden" name="foto_actual" value="<%= equipo.foto_url || '' %>">
    <label>Descripción<textarea name="descripcion" rows="3"><%= equipo.descripcion || '' %></textarea></label>
    <button type="submit">Guardar cambios</button>
</form>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<p><a href="/admin">&larr; Panel admin</a></p>
<h1>Noticias</h1>

<form method="POST" action="/admin/noticias" class="form" enctype="multipart/form-data">
    <label>Título<input type="text" name="titulo" required></label>
    <label>Fecha<input type="date" name="fecha" required></label>
    <label>Contenido<textarea name="contenido" rows="3"></textarea></label>
    <label>Foto (opcional)<input type="file" name="imagen" accept="image/*"></label>
    <button type="submit">Crear noticia</button>
</form>

<% if (noticias.length === 0) { %>
    <p>Aún no hay noticias.</p>
<% } else { %>
    <table class="tabla">
        <thead><tr><th>Título</th><th>Fecha</th><th></th></tr></thead>
        <tbody>
            <% noticias.forEach(function(n) { %>
                <tr>
                    <td><%= n.titulo %></td>
                    <td><%= new Date(n.fecha).toLocaleDateString('es-CO') %></td>
                    <td class="acciones">
                        <a href="/admin/noticias/<%= n.id %>/editar" class="btn-editar">Editar</a>
                        <form method="POST" action="/admin/noticias/<%= n.id %>/eliminar">
                            <button type="submit" class="btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>

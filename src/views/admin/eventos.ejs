<%- include('../partials/header') %>

<p><a href="/admin">&larr; Panel admin</a></p>
<h1>Eventos</h1>

<form method="POST" action="/admin/eventos" class="form" enctype="multipart/form-data">
    <label>Título<input type="text" name="titulo" required></label>
    <label>Fecha<input type="date" name="fecha" required></label>
    <label>Descripción<textarea name="descripcion" rows="3"></textarea></label>
    <label>Foto (opcional)<input type="file" name="imagen" accept="image/*"></label>
    <button type="submit">Crear evento</button>
</form>

<% if (eventos.length === 0) { %>
    <p>Aún no hay eventos.</p>
<% } else { %>
    <table class="tabla">
        <thead><tr><th class="tabla-col-foto">Foto</th><th>Título</th><th>Fecha</th><th></th></tr></thead>
        <tbody>
            <% eventos.forEach(function(ev) { %>
                <tr>
                    <td>
                        <% if (ev.imagen_url) { %>
                            <img src="<%= ev.imagen_url %>" alt="<%= ev.titulo %>" class="tabla-foto-mini">
                        <% } else { %>
                            <span class="tabla-foto-vacia">—</span>
                        <% } %>
                    </td>
                    <td><%= ev.titulo %></td>
                    <td><%= new Date(ev.fecha).toLocaleDateString('es-CO') %></td>
                    <td class="acciones">
                        <a href="/admin/eventos/<%= ev.id %>/editar" class="btn-editar">Editar</a>
                        <form method="POST" action="/admin/eventos/<%= ev.id %>/eliminar">
                            <button type="submit" class="btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>

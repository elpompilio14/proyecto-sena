<%- include('partials/header') %>

<h1>Equipos deportivos</h1>

<div class="categorias-grid">
    <div class="categoria-card categoria-baloncesto">
        <div class="categoria-card-icono">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 3v18"/>
                <path d="M3 12h18"/>
                <path d="M5.3 5.3c2.3 2.1 2.3 11.3 0 13.4"/>
                <path d="M18.7 5.3c-2.3 2.1-2.3 11.3 0 13.4"/>
            </svg>
        </div>
        <h3>Baloncesto</h3>
    </div>
    <div class="categoria-card categoria-futbol">
        <div class="categoria-card-icono">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <polygon points="12,7.2 15.2,9.5 14,13.2 10,13.2 8.8,9.5" fill="currentColor" stroke="none"/>
                <path d="M12 3v4.2M8.2 20.3l1.8-4.3M15.8 20.3l-1.8-4.3M3.4 9.2l4.1 1.4M20.6 9.2l-4.1 1.4M4.2 16.2l3.6-2.7M19.8 16.2l-3.6-2.7"/>
            </svg>
        </div>
        <h3>Fútbol</h3>
    </div>
    <div class="categoria-card categoria-balonmano">
        <div class="categoria-card-icono">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="currentColor">
                <circle cx="18" cy="6" r="2.6"/>
                <rect x="4" y="10" width="2.6" height="7" rx="1.3"/>
                <rect x="7.4" y="8" width="2.6" height="9" rx="1.3"/>
                <rect x="10.8" y="7.3" width="2.6" height="9.7" rx="1.3"/>
                <rect x="14.2" y="8.3" width="2.6" height="8.7" rx="1.3"/>
                <rect x="4" y="15.5" width="12.8" height="5" rx="2.2"/>
            </svg>
        </div>
        <h3>Balonmano</h3>
    </div>
    <div class="categoria-card categoria-badminton">
        <div class="categoria-card-icono">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="8" cy="8" rx="5" ry="6"/>
                <line x1="8" y1="2" x2="8" y2="14"/>
                <line x1="3" y1="8" x2="13" y2="8"/>
                <line x1="8" y1="14" x2="8" y2="19"/>
                <polygon points="17,13 21,17 18,20 14,16" fill="currentColor" stroke="none"/>
                <line x1="18" y1="16.5" x2="19.5" y2="18"/>
            </svg>
        </div>
        <h3>Bádminton</h3>
    </div>
</div>

<% if (equipos.length === 0) { %>
    <p>Aún no hay equipos registrados.</p>
<% } else { %>
    <div class="card-grid">
        <% equipos.forEach(function(eq, i) { %>
            <article class="card aparece" style="transition-delay: <%= Math.min(i, 5) * 70 %>ms">
                <% if (eq.foto_url) { %>
                    <img src="<%= eq.foto_url %>" alt="<%= eq.nombre %>" class="card-img">
                <% } %>
                <span class="badge"><%= eq.deporte_nombre %></span>
                <h3><%= eq.nombre %></h3>
                <% if (eq.categoria) { %><p class="fecha">Categoría: <%= eq.categoria %></p><% } %>
                <% if (eq.entrenador) { %><p class="fecha">Entrenador: <%= eq.entrenador %></p><% } %>
                <p><%- formatearTexto(eq.descripcion) %></p>
            </article>
        <% }) %>
    </div>
<% } %>

<%- include('partials/footer') %>

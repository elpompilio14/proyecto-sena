<%- include('partials/header') %>

<p><a href="/deportes">&larr; Volver a Deportes</a></p>

<h1><%= deporte.nombre %></h1>

<% if (deporte.imagen_url) { %>
    <img src="<%= deporte.imagen_url %>" alt="<%= deporte.nombre %>" class="card-img">
<% } %>

<% if (deporte.descripcion) { %>
    <p><%- formatearTexto(deporte.descripcion) %></p>
<% } else { %>
    <p>Aún no se ha agregado una descripción para este deporte.</p>
<% } %>

<% if (equipos.length > 0) { %>
    <h2>Equipos</h2>
    <div class="card-grid">
        <% equipos.forEach(function(eq, i) { %>
            <article class="card aparece" style="transition-delay: <%= Math.min(i, 5) * 70 %>ms">
                <% if (eq.foto_url) { %>
                    <img src="<%= eq.foto_url %>" alt="<%= eq.nombre %>" class="card-img">
                <% } %>
                <h3><%= eq.nombre %></h3>
                <% if (eq.categoria) { %><p class="fecha">Categoría: <%= eq.categoria %></p><% } %>
                <% if (eq.entrenador) { %><p class="fecha">Entrenador: <%= eq.entrenador %></p><% } %>
                <p><%- formatearTexto(eq.descripcion) %></p>
            </article>
        <% }) %>
    </div>
<% } %>

<%- include('partials/footer') %>

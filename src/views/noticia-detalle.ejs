<%- include('partials/header') %>

<p><a href="/noticias">&larr; Volver a Noticias</a></p>

<h1><%= noticia.titulo %></h1>
<p class="fecha"><%= new Date(noticia.fecha).toLocaleDateString('es-CO') %></p>
<p><%- formatearTexto(noticia.contenido) %></p>

<% if (noticia.imagen_url) { %>
    <img src="<%= noticia.imagen_url %>" alt="<%= noticia.titulo %>" class="card-img">
<% } %>

<% if (fotos.length > 0) { %>
    <h2 class="evento-mural-titulo">Fotos de <%= noticia.titulo %></h2>
    <div class="mural">
        <% fotos.forEach(function(f) { %>
            <figure>
                <% if (esVideo(f.url)) { %>
                    <div class="miniatura-video">
                        <video src="<%= f.url %>#t=0.5" data-url="<%= f.url %>" preload="metadata" muted playsinline></video>
                        <span class="icono-play">&#9658;</span>
                    </div>
                <% } else { %>
                    <img src="<%= f.url %>" data-url="<%= f.url %>" alt="<%= f.titulo || noticia.titulo %>">
                <% } %>
                <% if (f.titulo) { %><figcaption><%= f.titulo %></figcaption><% } %>
            </figure>
        <% }) %>
    </div>
<% } %>

<%- include('partials/footer') %>

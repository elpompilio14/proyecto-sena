<%- include('partials/header') %>

<div class="auth-wrapper">
    <div class="auth-container <%= tabActiva === 'registro' ? 'right-active' : '' %>" id="auth-container">

        <div class="auth-form-box auth-login <%= tabActiva === 'registro' ? '' : 'auth-visible-mobile' %>" id="caja-login">
            <form method="POST" action="/login" class="auth-form">
                <h2>Iniciar sesión</h2>

                <a href="/auth/google" class="auth-google-btn">
                    <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84c-.21 1.13-.84 2.09-1.79 2.73v2.27h2.9c1.7-1.57 2.69-3.88 2.69-6.64z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.17l-2.9-2.27c-.8.54-1.83.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.96v2.34C2.44 15.98 5.48 18 9 18z"/><path fill="#FBBC05" d="M3.95 10.7c-.18-.54-.28-1.11-.28-1.7s.1-1.16.28-1.7V4.96H.96C.35 6.17 0 7.55 0 9s.35 2.83.96 4.04l2.99-2.34z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0 5.48 0 2.44 2.02.96 4.96l2.99 2.34C4.66 5.17 6.65 3.58 9 3.58z"/></svg>
                    Ingresar con Google
                </a>
                <p class="auth-separador"><span>o con tu correo</span></p>

                <% if (errorLogin) { %>
                    <p class="error"><%= errorLogin %></p>
                <% } %>

                <input type="email" name="email" placeholder="Correo electrónico" required>
                <input type="password" name="password" placeholder="Contraseña" required>
                <button type="submit" class="auth-submit">Ingresar</button>

                <p class="auth-mobile-switch">¿No tienes cuenta? <a href="#" data-mostrar="registro">Regístrate</a></p>
            </form>
        </div>

        <div class="auth-form-box auth-registro <%= tabActiva === 'registro' ? 'auth-visible-mobile' : '' %>" id="caja-registro">
            <form method="POST" action="/registro" class="auth-form">
                <h2>Crear cuenta</h2>

                <a href="/auth/google" class="auth-google-btn">
                    <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84c-.21 1.13-.84 2.09-1.79 2.73v2.27h2.9c1.7-1.57 2.69-3.88 2.69-6.64z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.17l-2.9-2.27c-.8.54-1.83.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.96v2.34C2.44 15.98 5.48 18 9 18z"/><path fill="#FBBC05" d="M3.95 10.7c-.18-.54-.28-1.11-.28-1.7s.1-1.16.28-1.7V4.96H.96C.35 6.17 0 7.55 0 9s.35 2.83.96 4.04l2.99-2.34z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0 5.48 0 2.44 2.02.96 4.96l2.99 2.34C4.66 5.17 6.65 3.58 9 3.58z"/></svg>
                    Registrarme con Google
                </a>
                <p class="auth-separador"><span>o con tu correo</span></p>

                <% if (errorRegistro) { %>
                    <p class="error"><%= errorRegistro %></p>
                <% } %>

                <input type="text" name="nombre" placeholder="Nombre" required>
                <input type="text" name="apellido" placeholder="Apellido" required>
                <input type="email" name="email" placeholder="Correo electrónico" required>
                <input type="password" name="password" placeholder="Contraseña" required minlength="6">
                <input type="password" name="password_confirmar" placeholder="Confirmar contraseña" required minlength="6">
                <button type="submit" class="auth-submit">Crear cuenta</button>

                <p class="auth-mobile-switch">¿Ya tienes cuenta? <a href="#" data-mostrar="login">Inicia sesión</a></p>
            </form>
        </div>

        <div class="auth-overlay-container">
            <div class="auth-overlay">
                <div class="auth-overlay-panel auth-overlay-left">
                    <h2>¡Hola de nuevo!</h2>
                    <p>Si ya tienes una cuenta, inicia sesión aquí para continuar</p>
                    <button type="button" class="auth-ghost-btn" data-mostrar="login">Iniciar sesión</button>
                </div>
                <div class="auth-overlay-panel auth-overlay-right">
                    <h2>¡Bienvenido!</h2>
                    <p>Regístrate con tus datos para conocer más de nuestra comunidad</p>
                    <button type="button" class="auth-ghost-btn" data-mostrar="registro">Registrarse</button>
                </div>
            </div>
        </div>

    </div>
</div>

<%- include('partials/footer') %>
